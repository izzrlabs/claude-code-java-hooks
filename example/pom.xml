<?xml version="1.0" encoding="UTF-8"?>
<!--
  hooks-demo: a one-module Spring Boot app used only to show the three hooks in this
  repository working on a real build. See ../README.md, section "See it work".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.izzrlabs</groupId>
    <artifactId>hooks-demo</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>hooks-demo</name>
    <description>Example app for the claude-code-java-hooks repository</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      Spotless, so format-on-edit.sh (.claude/hooks/, see ../README.md "See it work")
      has something real to call: `grep -q spotless pom.xml` in that script checks this
      block exists before it tries `mvn spotless:apply`. Not bound to a lifecycle phase
      on purpose: `mvn test` stays fast, and the hook already scopes the call to one
      file with -DspotlessFiles.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>2.0.0</version>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
